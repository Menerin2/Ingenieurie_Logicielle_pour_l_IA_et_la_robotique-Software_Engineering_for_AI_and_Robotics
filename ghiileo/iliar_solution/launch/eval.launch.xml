<launch>

  <arg name="circuit" default="circuit1.sdf"/>
  <arg name="world" default=""/>
  
  <include file="$(find-pkg-share iliar_solution)/launch/autopilot_teleop.launch.xml">
  </include>

  <node
      pkg="iliar_solution"
      exec="path_publisher"
      name="path_pub"
      output="screen"
      args="$(find-pkg-share iliar_gazebo)/worlds/$(var circuit)">
    <remap from="road_path" to="/road_path"/>
  </node>

  <node pkg="iliar_solution" exec="path_dilater" name="path_track" output="screen">
    <param name="offset" value="3.75"/>
    <remap from="in_path" to="/road_path"/>
    <remap from="out_path" to="/lanes/track"/>
  </node>

  <node pkg="iliar_solution" exec="dist_to_path" name="dist_to_path" output="screen">
    <param name="base_frame" value="prius"/>
    <param name="signed_distance" value="false"/>
    <param name="use_sim_time" value="True"/>
  </node>

  <node pkg="iliar_solution" exec="scorer" name="scorer" output="screen">
    <remap from="/serie" to="/dist_to_path"/>
    <remap from="/min"  to="/dist_to_path/min"/>
    <remap from="/max"  to="/dist_to_path/max"/>
    <remap from="/avg"  to="/dist_to_path/avg"/>
    <param name="use_sim_time" value="True"/>
  </node>


  <node pkg="iliar_solution" exec="traveled_distance" name="traveled_distance" output="screen">
    <param name="base_frame" value="prius"/>
    <param name="use_sim_time" value="True"/>
    <remap from="path" to="/lanes/track"/>
  </node>

</launch>
