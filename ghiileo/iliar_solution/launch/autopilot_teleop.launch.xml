<launch>

  <arg name="circuit" default="circuit1.sdf"/>
  <arg name="world" default=""/>

  <!-- Lancer RViz et Gazebo avec la bonne config -->
  <include file="$(find-pkg-share iliar_solution)/launch/simu_gui.launch.xml">
    <arg name="circuit" value="$(var circuit)" />
    <arg name="world" value="$(var world)" /> 
  </include>

  <!-- Lancer le noeud d'autopilot -->
  <node 
    pkg="iliar_solution" 
    exec="autopilot" 
    name="autopilot" 
    output="screen"
    args = "$(find-pkg-share iliar_solution)/models/model.onnx">
  </node>

  <!-- Lancer le noeud de téléopération -->
  <node 
  pkg="iliar_solution" 
  exec="teleop_command" 
  name="teleop" 
  output="screen"
  args = "max_steer max_throttle max_brake steering_axis throttle_axis">
  </node>

  <node pkg="joy" exec="joy_node" name="joy" output="screen"/>

  <!-- Lancer le multiplexeur -->
  <node 
  pkg="iliar_solution" 
  exec="command_mux" 
  name="command_mux" 
  output="screen">
  
    <remap from="steering_out" to="audibot/steering_cmd"/> 
    <remap from="throttle_out" to="audibot/throttle_cmd"/>
    <remap from="brake_out" to="audibot/brake_cmd"/>
    <remap from="gear_out" to="audibot/gear_cmd"/>
  </node>

</launch>

